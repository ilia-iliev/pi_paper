{
  "name": "pi-paper",
  "version": "0.1.0",
  "description": "Read arXiv papers with a Pi agent in a sixel terminal",
  "type": "module",
  "bin": {
    "pi-paper": "dist/cli.js",
    "pi_paper": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "bench": "tsx bench/stream.bench.ts && tsx bench/render.bench.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
